<?xml version="1.0" encoding="utf-8"?>
<root>
	<windowclass name="charsheet_main">
		<placement>
			<size height="565" width="1290" />
		</placement>
		<sheetdata>
			<list_text name="theme_list">
				<bounds>2,2,982,557</bounds>
				<class>themedetails</class>
				<datasource>.theme_list</datasource>
				<allowcreate />
				<allowdelete />
				<empty>
					<textres>charsheet_main_theme_list_EmptyListText</textres>
				</empty>
				<columns>
					<width>242</width>
					<fillwidth />
				</columns>
				<newfocus>themes_cbx</newfocus>
			</list_text>
			<list_text name="stattag_list">
				<script>function onDrop(x, y, draginfo)
						if draginfo.getType() ~= "shortcut" then
							return false;
						end

						local sClass, sRecord = draginfo.getShortcutData();
						if not RecordDataManager.isRecordTypeDisplayClass("stattag", sClass) then
							return false;
						end

						local nodeSource = DB.findNode(sRecord);
						if not nodeSource then
							return false;
						end

						local wNew = createWindow();
						if not wNew then
							return false;
						end

						local nodeTarget = wNew.getDatabaseNode();
						DB.setValue(nodeTarget, "statustag_string", "string", DB.getValue(nodeSource, "name", ""));
						return true;
					end</script>
				<frame name="charsheet" offset="15,40,15,40" />
				<bounds>1002,40,280,200</bounds>
				<class>stattagdetails</class>
				<datasource>.stattag_list</datasource>
				<allowcreate />
				<allowdelete />
				<empty>
					<textres>charsheet_main_stattag_list_EmptyListText</textres>
				</empty>
				<columns>
					<width>280</width>
					<filldown />
				</columns>
				<newfocus>statustag_string</newfocus>
			</list_text>
			<list_text name="backpack_list">
				<frame name="charsheet" offset="15,40,15,40" />
				<bounds>1002,320,280,200</bounds>
				<class>backpackdetails</class>
