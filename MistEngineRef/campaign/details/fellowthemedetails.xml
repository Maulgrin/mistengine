			<buttoncontrol name="delete_btn">
				<bounds>224,2,15,15</bounds>
				<gmvisibleonly />
				<icon normal="button_delete" />
				<script>function onButtonPress()
						local node = window.getDatabaseNode();
					
						if not node then
							window.close();
							return;
						end
					
						if Session.IsHost then
							node.delete();
							return;
						end
					
						local msgOOB = {};
						msgOOB.type = "desktoplist_deleteitem";
						msgOOB.sNode = node.getPath();
					
						Comm.deliverOOBMessage(msgOOB, "");
					end
				</script>
